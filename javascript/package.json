{
  "name": "@openbindings/jsonata",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Closed, value-preserving JSONata execution for JavaScript and TypeScript",
  "main": "json-executor.js",
  "types": "json-executor.d.ts",
  "exports": {
    ".": { "types": "./json-executor.d.ts", "default": "./json-executor.js" },
    "./node": { "types": "./node-executor.d.ts", "default": "./node-executor.js" },
    "./package.json": "./package.json"
  },
  "files": ["json-executor*.js", "json-executor.d.ts", "node-executor.js", "node-executor.d.ts", "json-worker.js", "execution-options.js", "LICENSE", "README.md", "IMPLEMENTATION.md", "THIRD_PARTY_NOTICES.md", "BUILD.json"],
  "scripts": {
    "pretest": "npm run lint",
    "mocha": "nyc mocha \"test/**/*.js\"",
    "test": "npm run mocha",
    "posttest": "npm run check-coverage && npm run build",
    "build": "node scripts/build-runtime.cjs",
    "build-es5": "npm run build",
    "check-coverage": "nyc check-coverage --statements 100 --branches 100 --functions 100 --lines 100",
    "browserify": "npm run build",
    "browserify-es5": "npm run build",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build",
    "lint": "eslint src",
    "doc": "jsdoc --configure jsdoc.json src",
    "cover": "npm run mocha",
    "minify": "npm run build",
    "minify-es5": "npm run build"
  },
  "license": "MIT",
  "keywords": [
    "JSON",
    "query",
    "transformation",
    "transform",
    "mapping",
    "path"
  ],
  "devDependencies": {
    "@babel/cli": "^7.8.4",
    "@babel/core": "^7.8.4",
    "@babel/preset-env": "^7.8.4",
    "acorn": "8.18.0",
    "browserify": "17.0.1",
    "chai": "^4.2.0",
    "chai-as-promised": "^7.1.1",
    "eslint": "8.0.0",
    "eslint-plugin-ideal": "^0.1.3",
    "eslint-plugin-promise": "^6.0.0",
    "jsdoc": "4.0.5",
    "mkdirp": "^1.0.3",
    "mocha": "12.0.0",
    "mocha-lcov-reporter": "^1.3.0",
    "nyc": "18.0.0",
    "regenerator": "^0.14.4",
    "terser": "5.51.2",
    "uglify-es": "^3.3.10"
  },
  "dependencies": {
    "big.js": "7.0.1",
    "core-js-pure": "3.50.0",
    "decimal.js": "10.6.0",
    "lossless-json": "4.3.1"
  },
  "engines": {
    "node": ">= 8"
  }
}
